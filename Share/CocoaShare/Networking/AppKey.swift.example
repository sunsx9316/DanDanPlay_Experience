//
//  AppKey.swift.example
//  AniXPlayer
//
//  复制本文件为 AppKey.swift，并填入在 https://doc.dandanplay.com/open/ 申请的凭证。
//  AppKey.swift 已被 .gitignore 忽略，不要提交真实凭证。
//
//  注意：AppId/AppSecret 用于开放平台请求签名（X-AppId/X-Signature），
//  与 OAuth 的 client_id 是两套凭证，不要混用。
//

import Foundation

/// 弹弹play 开放平台应用凭证
struct AppKey {
    /// 应用 AppId（macOS 已注册：anixplayermacv1）
    static var appId = "anixplayermacv1"
    /// 应用 AppSecret：iOS/tvOS 旧签名接口需要；macOS 不使用
    static var appSec = "YOUR_APP_SECRET"
}
