{
  "sourceLanguage": "en",
  "strings": {
    "%@\n\n可能是文件夹已移动或访问权限失效。重新选择该文件夹即可更新授权。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nThe folder may have moved or access may have expired. Select the folder again to renew access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n可能是文件夹已移动或访问权限失效。重新选择该文件夹即可更新授权。"
          }
        }
      }
    },
    "%@\n\n文件夹「%@」的访问权限可能已失效。重新选择文件夹即可更新授权。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nAccess to folder “%@” may have expired. Choose the folder again to renew access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n文件夹「%@」的访问权限可能已失效。重新选择文件夹即可更新授权。"
          }
        }
      }
    },
    "%@\n\n重叠范围内的视频只保留首次入库的文件夹归属，不会重复计数；移除其中一个文件夹也不会删除另一个文件夹的索引。是否仍然添加？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nVideos in the overlapping range keep the folder they were first added under and are not counted twice. Removing either folder does not delete the other folder’s entries. Add anyway?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n重叠范围内的视频只保留首次入库的文件夹归属，不会重复计数；移除其中一个文件夹也不会删除另一个文件夹的索引。是否仍然添加？"
          }
        }
      }
    },
